# VPS Deployment Configuration
# VIP Suite - Staging Environment

# VPS Details
VPS_IP=201.22.86.97
VPS_USER=bvip
VPS_PORT=22
VPS_DOMAIN=suite.franquiabv.xyz

# Application
APP_PORT=3098
NODE_ENV=production
APP_NAME=vip-suite

# Database (MySQL - Local only, Master-Slave replication)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=suite
DB_USER=suite
DB_PASSWORD=D5mj476Bf07n@
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=15000
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=10000

# Redis (Local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_DASHBOARD=300
REDIS_TTL_REPORTS=600

# SSL/TLS
SSL_EMAIL=contato@barbeariavip.com.br
SSL_PROVIDER=letsencrypt

# Logging & Monitoring
LOG_LEVEL=info
LOG_DIR=/var/log/vip-suite
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/vip-suite

# Docker
DOCKER_REGISTRY=
DOCKER_IMAGE=vip-suite
DOCKER_TAG=latest
